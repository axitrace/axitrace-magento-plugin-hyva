<?php
/**
 * AxiTrace storefront pixel — Hyva theme.
 *
 * CSP-strict. Every inline <script> is followed by $hyvaCsp->registerInlineScript()
 * with the correct path so Hyva's nonce/hash registry accepts it.
 *
 * Alpine usage follows Hyva CSP-build conventions:
 *   - x-data="axitracePixel"   (NO parens — CSP build forbids expression eval)
 *   - Alpine.data('axitracePixel', () => ({ init() { ... } })) registered via alpine:init.
 *
 * @var Magento\Framework\View\Element\Template $block
 * @var Hyva\Theme\Model\ViewModelRegistry $viewModels
 * @var Magento\Framework\Escaper $escaper
 * @var Hyva\Theme\Service\CurrentTheme $currentTheme
 *
 * Note: $hyvaCsp is provided by Hyva_Theme on every storefront template.
 */

use AxiTrace\Tracking\ViewModel\CategoryContext;
use AxiTrace\Tracking\ViewModel\CheckoutContext;
use AxiTrace\Tracking\ViewModel\ProductContext;
use AxiTrace\Tracking\ViewModel\StorefrontConfig;

/** @var StorefrontConfig|null $viewModel */
$viewModel = $block->getData('view_model');
if (!$viewModel || !$viewModel->isEnabled()) {
    return;
}

$config = $viewModel->getInlineConfig();
$configJson = (string) json_encode($config, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES);

$productPayload = null;
$productVm = $block->getData('product_view_model');
if ($productVm instanceof ProductContext) {
    $productPayload = $productVm->getProductPayload();
}

$categoryPayload = null;
$categoryVm = $block->getData('category_view_model');
if ($categoryVm instanceof CategoryContext) {
    $categoryPayload = $categoryVm->getCategoryPayload();
}

$checkoutPayload = null;
$checkoutVm = $block->getData('checkout_view_model');
if ($checkoutVm instanceof CheckoutContext) {
    $checkoutPayload = $checkoutVm->getCheckoutPayload();
}

$extraJson = (string) json_encode(
    array_filter([
        'product'  => $productPayload ?: null,
        'category' => $categoryPayload ?: null,
        'checkout' => $checkoutPayload ?: null,
    ]),
    JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES
);

$trackingDomain = (string) $config['trackingDomain'];
$sdkUrl = 'https://' . htmlspecialchars($trackingDomain, ENT_QUOTES, 'UTF-8') . '/axitrack.js';
?>
<div x-data="axitracePixel" data-axi-config='<?= /* @noEscape */ $configJson ?>' data-axi-context='<?= /* @noEscape */ $extraJson ?>'></div>

<script>
    document.addEventListener('alpine:init', () => {
        Alpine.data('axitracePixel', () => ({
            init() {
                let cfg = {};
                let ctx = {};
                try {
                    cfg = JSON.parse(this.$el.dataset.axiConfig || '{}');
                    ctx = JSON.parse(this.$el.dataset.axiContext || '{}');
                } catch (e) {
                    return;
                }
                window.axitraceConfig = cfg;
                window.axitracePageContext = ctx;

                const sdkUrl = <?= /* @noEscape */ json_encode($sdkUrl, JSON_THROW_ON_ERROR | JSON_UNESCAPED_SLASHES) ?>;
                const existing = document.querySelector('script[data-axitrace-sdk="1"]');
                if (!existing) {
                    const script = document.createElement('script');
                    script.defer = true;
                    script.src = sdkUrl;
                    script.setAttribute('data-axitrace-sdk', '1');
                    document.body.appendChild(script);
                }

                const dispatch = () => {
                    if (!cfg.publicKey) { return; }
                    const toggles = cfg.toggles || {};
                    let tracker;
                    try {
                        tracker = window.Axitrace.init({
                            publicKey: cfg.publicKey,
                            apiUrl:    cfg.apiBaseUrl || ('https://' + cfg.trackingDomain),
                            debug:     !!cfg.debug
                        });
                    } catch (e) { return; }
                    if (!tracker || typeof tracker.track !== 'function') { return; }
                    window.axitrace = tracker;
                    try { window.dispatchEvent(new Event('axitrace:ready')); } catch (e) {}

                    switch (cfg.pageType) {
                        case 'product':
                            if (toggles.view_content !== false && ctx.product) {
                                tracker.track('product.view', {
                                    sku: ctx.product.sku,
                                    productId: ctx.product.productId,
                                    name: ctx.product.name,
                                    price: ctx.product.price,
                                    currency: ctx.product.currency,
                                    products: [ctx.product],
                                    source: 'magento-hyva'
                                });
                            }
                            break;
                        case 'category':
                            if (toggles.view_category !== false) {
                                tracker.track('page.view', {
                                    pageType: 'category',
                                    category: ctx.category || null,
                                    source: 'magento-hyva'
                                });
                            }
                            break;
                        case 'checkout':
                            if (toggles.begin_checkout !== false) {
                                const checkoutCtx = ctx.checkout || {};
                                tracker.track('begin_checkout', {
                                    value: checkoutCtx.value,
                                    currency: checkoutCtx.currency,
                                    itemCount: checkoutCtx.itemCount,
                                    source: 'magento-hyva'
                                });
                            }
                            break;
                        case 'confirmation':
                            break;
                        default:
                            if (toggles.page_view !== false && cfg.pageType) {
                                tracker.track('page.view', { pageType: cfg.pageType, source: 'magento-hyva' });
                            }
                            break;
                    }

                    if (cfg.pageType === 'checkout' && toggles.add_payment_info !== false) {
                        let paymentInfoFired = false;
                        const firePaymentInfo = () => {
                            if (paymentInfoFired) { return; }
                            paymentInfoFired = true;
                            const checkoutCtx = ctx.checkout || {};
                            tracker.track('add_payment_info', {
                                value: checkoutCtx.value,
                                currency: checkoutCtx.currency,
                                itemCount: checkoutCtx.itemCount,
                                source: 'magento-hyva'
                            });
                        };
                        // Primary signal: the checkout SPA reflects the active step in the
                        // URL hash (#shipping / #payment) via
                        // Magento_Checkout/js/model/step-navigator, or Hyva Checkout's own
                        // step router when that extension is installed — both fire
                        // regardless of how many payment methods are configured, unlike a
                        // radio "change" listener alone (which never fires when only one
                        // payment method exists and is auto-selected without user input).
                        if (window.location.hash === '#payment') {
                            firePaymentInfo();
                        }
                        window.addEventListener('hashchange', () => {
                            if (window.location.hash === '#payment') {
                                firePaymentInfo();
                            }
                        }, false);
                        // Fallback: some checkout customizations don't sync the active
                        // step to the URL hash. A delegated change listener on the
                        // payment method radios catches those too.
                        document.addEventListener('change', (e) => {
                            const t = e.target;
                            if (!t || !t.name || t.name.indexOf('payment[method]') !== 0) { return; }
                            firePaymentInfo();
                        }, true);
                    }

                    if (toggles.add_to_cart !== false) {
                        document.addEventListener('click', (e) => {
                            const btn = e.target && e.target.closest
                                ? e.target.closest('button[data-role="tocart-form"] button, button.tocart, button.action.tocart, form[data-role="tocart-form"] button[type="submit"], [data-axi-addtocart]')
                                : null;
                            if (!btn || !ctx.product) { return; }
                            tracker.track('product.addToCart', {
                                sku: ctx.product.sku,
                                productId: ctx.product.productId,
                                name: ctx.product.name,
                                price: ctx.product.price,
                                currency: ctx.product.currency,
                                quantity: 1,
                                products: [ctx.product],
                                source: 'magento-hyva'
                            });
                        }, false);
                    }
                };

                const waitFor = () => {
                    if (window.Axitrace && typeof window.Axitrace.init === 'function') {
                        dispatch();
                        return;
                    }
                    setTimeout(waitFor, 50);
                };
                waitFor();
            }
        }));
    });
</script>
<?= /* @noEscape */ $hyvaCsp->registerInlineScript() ?>
