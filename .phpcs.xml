<?xml version="1.0"?>
<ruleset name="Hyva_AxiTraceTracking" namespace="Hyva\AxiTraceTracking\PHPCS">
    <description>PHPCS configuration for Hyva_AxiTraceTracking compat module.</description>

    <rule ref="Magento2"/>

    <arg name="severity" value="10"/>
    <arg name="warning-severity" value="10"/>
    <arg name="error-severity" value="10"/>
    <arg name="colors"/>
    <arg name="extensions" value="php,phtml"/>
    <arg name="parallel" value="4"/>

    <file>./</file>

    <exclude-pattern>./vendor/*</exclude-pattern>
</ruleset>
